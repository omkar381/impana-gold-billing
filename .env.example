# Flask environment
FLASK_ENV=development
FLASK_APP=app.py

# Secret key for sessions/CSRF — use a long random string in production
SECRET_KEY=your-very-long-random-secret-key-here

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/impana_gold

# Admin seeding (used by seed.py ONLY — change after first run)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe@123
